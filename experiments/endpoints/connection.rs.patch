+
+async fn benchmark_roots() -> Result<tls::rustls::RootCertStore> {
+  if let Ok(path) = std::env::var("MOQ_TEST_CA_FILE") {
+    let certificate = tls::Certificate::load_pemfile(path).await?;
+    let mut roots = tls::rustls::RootCertStore::empty();
+    roots.add(tls::rustls::pki_types::CertificateDer::from(certificate.der().to_vec()))?;
+    Ok(roots)
+  } else {
+    Ok(tls::build_native_cert_store())
+  }
+}
